#!/usr/bin/env ruby
# frozen_string_literal: true

#
# Checks every domain on the list with the standard import checks (including
# DNS resolution) and removes the ones that fail
#
# Usage: script/validate-domains

require './lib/gman/importer'
require 'parallel'

importer = Gman::Importer.new({})
options = { skip_dupe: true, skip_resolve: false }
list_path = File.expand_path '../config/domains.txt', __dir__

# Registry suffixes (e.g., gouv.fr, fed.us) have no DNS records of their own
SKIP_GROUPS = ['non-us gov', 'non-us mil', 'US Federal'].freeze

importer.logger.info "Starting list: #{Gman::DomainList.current.count} domains"

# Validate in parallel, but only collect the results there. Each worker used to
# read, edit and write domains.txt itself, so concurrent removals overwrote one
# another.
invalid = Gman.list.to_h.to_a.shuffle.flat_map do |group, domains|
  next [] if SKIP_GROUPS.include?(group)

  Parallel.map(domains, progress: "Validating #{group}") do |domain|
    next if domain.start_with?('!')
    next if importer.valid_domain?(domain, options)

    importer.logger.warn "#{domain} is not valid, removing from list"
    domain
  end.compact
end

list = File.read(list_path)
invalid.each { |domain| list.gsub!(/^#{Regexp.escape(domain)}(?:\n|\z)/, '') }
File.write list_path, list

importer.logger.info "Ending list: #{Gman::DomainList.current.count} domains"
