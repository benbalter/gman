#! /usr/bin/env ruby
# frozen_string_literal: true

# Given a domain-link string, returns information about the domain

require_relative '../lib/gman'

# Convenience method to simplify the command-line logic
class IsoCountryCodes
  class Code
    def to_s
      name
    end
  end
end

domain = ARGV[0]
COLOR = ARGV.last != '--no-color' && ENV.fetch('NO_COLOR', '').empty?

def red(string)
  COLOR ? "\e[31m#{string}\e[0m" : string
end

def green(string)
  COLOR ? "\e[32m#{string}\e[0m" : string
end

if domain.to_s.empty? || domain == '--no-color'
  puts red('USAGE: gman <domain or email address> [--no-color]')
  exit 1
end

gman = Gman.new(domain)

puts "Domain  : #{gman.domain}"

if gman.domain.nil?
  puts "Status  : #{red('Invalid domain')}"
  exit 1
end

unless gman.valid?
  puts "Status  : #{red('Not a government domain')}"
  exit 1
end

puts "Status  : #{green('Valid government domain')}"

%w[type country state city agency].each do |key|
  value = gman.send(key)
  puts "#{key.capitalize.ljust(8)}: #{value}" if value
end
